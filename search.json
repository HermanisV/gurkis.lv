---
layout: null
---
[
  {% assign sorted_recipes = site.recipes | sort: "date" | reverse %}
  {% for recipe in sorted_recipes %}
    {% assign all_ingredients = "" | split: "" %}
    {% for group in recipe.ingredients %}
      {% for ing in group.items %}
        {% assign combined = ing.amount | append: " " | append: ing.item %}
        {% assign all_ingredients = all_ingredients | push: combined %}
      {% endfor %}
    {% endfor %}
    {
      "title": {{ recipe.title | jsonify }},
      "url": {{ recipe.url | relative_url | jsonify }},
      "image": {{ recipe.image | default: "" | jsonify }},
      "description": {{ recipe.description | default: "" | jsonify }},
      "categories": {{ recipe.categories | default: empty | jsonify }},
      "tags": {{ recipe.tags | default: empty | jsonify }},
      "prep_time": {{ recipe.prep_time | default: 0 | jsonify }},
      "cook_time": {{ recipe.cook_time | default: 0 | jsonify }},
      "servings": {{ recipe.servings | default: 4 | jsonify }},
      "ingredients": {{ all_ingredients | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]

