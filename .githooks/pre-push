#!/usr/bin/env sh
branch="$(git rev-parse --abbrev-ref HEAD)"

case "$branch" in
  feat/*|fix/*)
    ;;
  *)
    echo "ERROR: Invalid local branch '$branch'."
    echo "Only 'feat/<name>' and 'fix/<name>' branches may be pushed."
    exit 1
    ;;
esac

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/feat/*|refs/heads/fix/*)
      ;;
    *)
      echo "ERROR: Pushing to '$remote_ref' is forbidden."
      echo "Only 'refs/heads/feat/*' and 'refs/heads/fix/*' remote branches are allowed."
      exit 1
      ;;
  esac
done
